#!/bin/bash
set -euxo pipefail
exec > >(tee -a /var/log/energia-bootstrap.log) 2>&1

dnf install -y docker git jq amazon-cloudwatch-agent
systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /usr/local/lib/docker/cli-plugins
cd /tmp
curl -fsSL -o docker-compose-linux-x86_64 \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64"
curl -fsSL -o docker-compose-linux-x86_64.sha256 \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64.sha256"
sha256sum -c docker-compose-linux-x86_64.sha256
install -m 0755 docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

mkdir -p ${repo_dir}/logs
chown -R ec2-user:ec2-user ${repo_dir}
chown 50000:0 ${repo_dir}/logs

cat > /etc/energia-data.conf <<'CONF'
REGION=${region}
CONFIG_PARAMETER=${config_parameter}
WAREHOUSE_SECRET_ID=${warehouse_secret_id}
MACHINE_CLIENT_SECRET_ID=${machine_client_secret_id}
AIRFLOW_SECRET_ID=${airflow_secret_id}
ENV_FILE=${repo_dir}/.env
CONF
echo '${render_script_b64}' | base64 -d > /usr/local/bin/render-airflow-env.sh
chmod 0755 /usr/local/bin/render-airflow-env.sh

cat > /etc/systemd/system/energia-render-env.service <<'UNIT'
[Unit]
Description=Render /opt/energia-data/.env from Secrets Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/render-airflow-env.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now energia-render-env.service

echo '${cloudwatch_config_b64}' | base64 -d > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
